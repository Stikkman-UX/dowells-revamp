{
  "name": "dowells-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "cross-env ENVIRONMENT=production node -r module-alias/register build/src/index.js",
    "dev": "cross-env ENVIRONMENT=development ts-node-dev --files --respawn -r tsconfig-paths/register src/index.ts",
    "build": "tsc --project ./",
    "typecheck": "tsc --noEmit",
    "seed": "cross-env ENVIRONMENT=development ts-node -r tsconfig-paths/register src/seed/index.ts",
    "seed:admin": "cross-env ENVIRONMENT=development ts-node -r tsconfig-paths/register src/seed/admin.ts",
    "seed:home": "cross-env ENVIRONMENT=development ts-node -r tsconfig-paths/register src/seed/home.ts",
    "seed:products": "cross-env ENVIRONMENT=development ts-node -r tsconfig-paths/register src/seed/products.ts"
  },
  "keywords": [],
  "author": "Aurobindo Bhuyan",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/lib-storage": "^3.1037.0",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.3.4",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "morgan-json": "^1.1.0",
    "multer": "^2.0.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "winston": "^3.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.9.0",
    "@types/qs": "^6.9.18",
    "prettier": "^3.3.3",
    "ts-node-dev": "^2.0.0"
  },
  "_moduleAliases": {
    "@models": "build/src/models",
    "@utils": "build/src/utils",
    "@controllers": "build/src/controllers",
    "@config": "build/src/config",
    "@routes": "build/src/routes",
    "@src": "build/src"
  }
}
